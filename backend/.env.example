# Database Configuration
MONGODB_URI=mongodb://localhost:27017/your_database_name
# For production: mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Configuration
# - ADMIN_EMAIL and ADMIN_PASSWORD are kept for simple local/dev testing.
# - In production you should set ADMIN_EMAILS to a comma-separated list of allowed admin emails.
# - Admin authentication expects JWTs issued for one of the emails listed in ADMIN_EMAILS.
ADMIN_EMAIL=admin@kharido.com
ADMIN_PASSWORD=admin123
# Comma-separated list of admin emails (supports multiple admin accounts)
ADMIN_EMAILS=admin@kharido.com,admin2@kharido.com

# Email Verification (Gmail verification system)
# The application uses a Gmail-based verification system by default which validates
# email existence and sends verification emails. Set the following values to enable it.
# See GMAIL_VERIFICATION_SETUP.md for full instructions (Gmail App Password, 2FA, etc.)
USE_LEGACY_EMAIL_VALIDATOR=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
# Domain used in verification links and templates (e.g. your sending domain)
EMAIL_VERIFICATION_DOMAIN=kharido.com
# FRONTEND_URL is used to build verification link targets in emails (ensure correct for production)
FRONTEND_URL=http://localhost:5173

# Development Settings
# Set this to false in production to require email verification before login
SKIP_EMAIL_VERIFICATION=false

# Logging Controls
# Set these to true in non-sensitive environments to enable additional logs.
# For production, it's recommended to keep these false unless troubleshooting.
ENABLE_SECURITY_LOGS=false
ENABLE_PERF_LOGS=false

# Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
# This is used by the backend to allow requests from the frontend application.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Optional: For production deployment (uncomment & set appropriately)
# FRONTEND_URL=https://kharido.vercel.app
# ADMIN_URL=https://kharido-admin.vercel.app

# Google OAuth Client ID for verifying Google ID tokens
GOOGLE_CLIENT_ID=

# Notes for Render Deployment
# When deploying to Render (or other hosting), the variables above must be set in the
# service's Environment settings (Render Dashboard). Do NOT rely solely on local .env files.
# Ensure EMAIL_USER, EMAIL_PASSWORD, EMAIL_VERIFICATION_DOMAIN, ADMIN_EMAILS, JWT_SECRET,
# MONGODB_URI, and payment-related keys are configured in the Render environment.
# See RENDER_DEPLOYMENT_INSTRUCTIONS.md for step-by-step instructions.