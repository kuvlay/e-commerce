# Frontend Environment Variables
# Copy this file to .env.local and configure your values

# Backend API URL - required for API client
VITE_BACKEND_URL=http://localhost:5000

# API Logging - set to 'true' to enable API request/response logging
VITE_API_LOGGING=false

# Google OAuth Client ID for Google Identity Services
VITE_GOOGLE_CLIENT_ID=

