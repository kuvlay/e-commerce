{
  "name": "kharido-ecommerce",
  "version": "1.0.0",
  "description": "Kharido E-commerce Platform - Modern ecommerce solution with frontend, backend, and admin panel",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:admin\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run server",
    "dev:admin": "cd admin && npm run dev",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../admin && npm install",
    "build": "cd frontend && npm run build && cd ../admin && npm run build",
    "start": "cd backend && npm start",
    "validate:env": "node validate-env.cjs",
    "validate:env:backend": "node validate-env.cjs --backend",
    "validate:env:frontend": "node validate-env.cjs --frontend",
    "validate:env:admin": "node validate-env.cjs --admin",
    "test": "npm run test:frontend && npm run test:backend && npm run test:admin",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "test:admin": "cd admin && npm test",
    "test:watch": "concurrently \"npm run test:frontend:watch\" \"npm run test:backend:watch\" \"npm run test:admin:watch\"",
    "test:frontend:watch": "cd frontend && npm run test:watch",
    "test:backend:watch": "cd backend && npm run test:watch",
    "test:admin:watch": "cd admin && npm run test:watch",
    "test:summary": "node test-runner.js",
    "test:ci": "npm run test:summary",
    "setup:hooks": "node scripts/setup-hooks.js",
    "test:pre-commit": "node scripts/pre-commit-hook.js",
    "perf:analyze": "node scripts/performance-monitor.js --analyze",
    "perf:check": "node scripts/performance-monitor.js --check-regression",
    "perf:dashboard": "node scripts/performance-dashboard.js",
    "bundle:analyze": "node scripts/bundle-analyzer.js",
    "bundle:check": "node scripts/bundle-analyzer.js --check-thresholds"
  },
  "keywords": [
    "ecommerce",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "react-toastify": "^10.0.6"
  }
}